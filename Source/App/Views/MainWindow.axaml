<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UnVault.App.ViewModels"
        xmlns:views="using:UnVault.App.Views"
        x:Class="UnVault.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/unvault.ico"
        Title="UnVault Launcher"
        Width="1100" Height="760" MinWidth="760" MinHeight="520"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <Grid RowDefinitions="Auto,Auto,*,Auto">

            <!-- Header -->
            <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Image Source="/Assets/unvault-logo.png" Width="28" Height="28" />
                            <TextBlock Text="UnVault" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="Launcher" FontSize="18" Classes="muted" VerticalAlignment="Center" Margin="-4,0,0,0" />
                            <!-- The version opens About; a pill beside it tells when a newer release is out -->
                            <Button Classes="subtle" Padding="4,1" Margin="-6,3,0,0" VerticalAlignment="Center" Command="{Binding OpenAboutCommand}"
                                    ToolTip.Tip="About UnVault Launcher" AutomationProperties.Name="About UnVault Launcher">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding VersionText}" Classes="muted small" VerticalAlignment="Center" />
                                    <Border Classes="chip warning" IsVisible="{Binding HasAppUpdate}">
                                        <TextBlock Text="Update available" />
                                    </Border>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Button Content="Engines" Classes="tab" Classes.active="{Binding IsEnginesTab}" Command="{Binding ShowEnginesCommand}" />
                            <Button Classes="tab" Classes.active="{Binding IsFabTab}" Command="{Binding ShowFabCommand}" ToolTip.Tip="{Binding LibraryUpdatesText}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="Library" />
                                    <!-- Something in the library has a newer build on Fab -->
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" IsVisible="{Binding HasLibraryUpdates}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="subtle" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh" AutomationProperties.Name="Refresh" IsEnabled="{Binding !IsLoading}" Padding="8">
                            <!-- A clockwise arrow: a ring around (8,8) open at the top right, ending in an arrowhead -->
                            <PathIcon Width="15" Height="15"
                                      Data="F1 M13.95,8 A5.95,5.95 0 1 1 12.207,3.793 L11.217,4.783 A4.55,4.55 0 1 0 12.55,8 A0.7,0.7 0 0 1 13.95,8 Z M13.4,6 L9.6,5.7 L13.1,2.2 Z" />
                        </Button>
                        <Button Classes="subtle" Content="Settings" Command="{Binding OpenSettingsCommand}" />
                        <Button Content="Sign In" Classes="accent" Command="{Binding SignInCommand}" IsVisible="{Binding IsSignedOut}" />
                        <Button Classes="subtle" IsVisible="{Binding IsSignedIn}" Padding="6,4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <!-- Avatar: a grey circle with a head and shoulders cut out; one shape, so no edges overlap.
                                     The shoulders stop inside the circle, leaving a grey band under them. -->
                                <Path Width="28" Height="28" Fill="{StaticResource MutedTextBrush}">
                                    <Path.Data>
                                        <CombinedGeometry GeometryCombineMode="Exclude">
                                            <CombinedGeometry.Geometry1>
                                                <EllipseGeometry Rect="0,0,28,28" />
                                            </CombinedGeometry.Geometry1>
                                            <CombinedGeometry.Geometry2>
                                                <GeometryGroup FillRule="NonZero">
                                                    <EllipseGeometry Center="14,11.3" RadiusX="4.7" RadiusY="4.7" />
                                                    <CombinedGeometry GeometryCombineMode="Intersect">
                                                        <CombinedGeometry.Geometry1>
                                                            <EllipseGeometry Center="14,25.2" RadiusX="9" RadiusY="7.5" />
                                                        </CombinedGeometry.Geometry1>
                                                        <CombinedGeometry.Geometry2>
                                                            <EllipseGeometry Rect="2.5,2.5,23,23" />
                                                        </CombinedGeometry.Geometry2>
                                                    </CombinedGeometry>
                                                </GeometryGroup>
                                            </CombinedGeometry.Geometry2>
                                        </CombinedGeometry>
                                    </Path.Data>
                                </Path>
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                            </StackPanel>
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Sign Out" Command="{Binding SignOutCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- A problem worth telling about (failed sign-in, Epic unreachable…), above either tab -->
            <Border Grid.Row="1" Classes="banner warning" Margin="24,16,24,0" MaxWidth="{StaticResource PageMaxWidth}" IsVisible="{Binding HasNotice}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="subtle" Content="✕" Command="{Binding DismissNoticeCommand}"
                            ToolTip.Tip="Dismiss" AutomationProperties.Name="Dismiss" />
                </Grid>
            </Border>

            <!-- Engines -->
            <ScrollViewer Grid.Row="2" IsVisible="{Binding IsEnginesTab}">
                <StackPanel Margin="24,20,24,24" Spacing="12" MaxWidth="{StaticResource PageMaxWidth}">

                    <Border Classes="banner" IsVisible="{Binding IsSignedOut}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                       Text="Sign in to see every engine version your account can install. Installed engines can be modified and verified without signing in." />
                            <Button Grid.Column="1" Content="Sign In" Classes="accent" Margin="12,0,0,0" Command="{Binding SignInCommand}" />
                        </Grid>
                    </Border>

                    <Grid Classes="title" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Text="Unreal Engine" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <!-- Refresh progress, next to the title -->
                        <DockPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center" IsVisible="{Binding IsLoading}">
                            <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="120" />
                            <TextBlock Text="{Binding LoadingText}" Classes="muted" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Button Grid.Column="2" Classes="accent" Command="{Binding InstallEngineCommand}" Padding="10"
                                ToolTip.Tip="Install Engine" AutomationProperties.Name="Install Engine">
                            <!-- A bold plus: two bars crossing in the middle of a 16 px grid -->
                            <PathIcon Width="14" Height="14" Data="M6.7,2 H9.3 V6.7 H14 V9.3 H9.3 V14 H6.7 V9.3 H2 V6.7 H6.7 Z" />
                        </Button>
                    </Grid>

                    <StackPanel IsVisible="{Binding HasNoEngines}" Margin="0,32" Spacing="6" HorizontalAlignment="Center">
                        <TextBlock Text="No engines installed yet." FontSize="16" HorizontalAlignment="Center" />
                        <TextBlock Text="Click + to pick a version and only the components you need." Classes="muted" HorizontalAlignment="Center" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Engines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:EngineCardViewModel">
                                <views:EngineCardView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>

            <!-- Fab -->
            <views:FabLibraryView Grid.Row="2" DataContext="{Binding Fab}" IsVisible="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsFabTab}" />

            <!-- Downloads / running jobs -->
            <Border Grid.Row="3" IsVisible="{Binding HasOperations}" Background="{StaticResource HeaderBackgroundBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12" MaxHeight="260">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Operations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="12" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:OperationViewModel">
                                <views:OperationView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Dialog overlay: Tab goes round the dialog's controls and never reaches the page behind -->
        <Border Background="{StaticResource OverlayBrush}" IsVisible="{Binding HasDialog}" KeyboardNavigation.TabNavigation="Cycle">
            <!-- Takes the focus when a dialog opens (see FocusDialog), but isn't a stop for Tab itself -->
            <ContentControl x:Name="DialogHost" Content="{Binding Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                            Focusable="True" KeyboardNavigation.IsTabStop="False">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vm:ComponentPickerViewModel">
                        <views:ComponentPickerView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:SettingsViewModel">
                        <views:SettingsView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:FabActionViewModel">
                        <views:FabActionView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ConfirmViewModel">
                        <views:ConfirmView />
                    </DataTemplate>
                    <DataTemplate DataType="vm:AboutViewModel">
                        <views:AboutView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>
    </Grid>
</Window>
