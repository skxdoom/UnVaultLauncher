<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:UnVault.App"
             xmlns:vm="using:UnVault.App.ViewModels"
             x:Class="UnVault.App.Views.ConfirmView"
             x:DataType="vm:ConfirmViewModel"
             Width="480">

    <Border Classes="card dialog">
        <StackPanel>
            <StackPanel Margin="24,20,24,0" Spacing="10">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="muted" />
            </StackPanel>
            <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{x:Static s:Strings.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="{Binding ConfirmText}" Classes="accent" Command="{Binding ConfirmCommand}" IsDefault="True" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
