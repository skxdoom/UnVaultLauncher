<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UnVault.App.ViewModels"
             x:Class="UnVault.App.Views.AboutView"
             x:DataType="vm:AboutViewModel"
             Width="540">

    <Border Classes="card dialog">
        <Grid RowDefinitions="*,Auto">
            <StackPanel Margin="24,22,24,0">
                <Grid ColumnDefinitions="Auto,*">
                    <Image Source="/Assets/unvault-logo.png" Width="52" Height="52" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="UnVault Launcher" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding VersionText}" Classes="muted" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="A streamlined and lightweight launcher for installing and managing Unreal Engine and Fab assets and plugins."
                           TextWrapping="Wrap" Margin="0,16,0,0" />

                <!-- Whether this is the latest release -->
                <Border Classes="banner" Classes.warning="{Binding Owner.HasAppUpdate}" Margin="0,16,0,0">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Owner.UpdateStatusText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Download" Classes="update" Margin="12,0,0,0" Command="{Binding DownloadCommand}"
                                IsVisible="{Binding Owner.HasAppUpdate}" />
                        <Button Grid.Column="1" Content="Check Again" Margin="12,0,0,0" Command="{Binding CheckAgainCommand}"
                                IsVisible="{Binding !Owner.HasAppUpdate}" />
                    </Grid>
                </Border>

                <TextBlock Text="LINKS" Classes="section" />
                <WrapPanel>
                    <Button Classes="link" Content="GitHub" Margin="0,0,18,6" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding RepositoryURL}" />
                    <Button Classes="link" Content="Releases" Margin="0,0,18,6" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding ReleasesURL}" />
                    <Button Classes="link" Content="Report an Issue" Margin="0,0,18,6" Command="{Binding OpenLinkCommand}" CommandParameter="{Binding IssuesURL}" />
                    <Button Classes="link" Content="Open Data Folder" Margin="0,0,18,6" Command="{Binding OpenDataFolderCommand}"
                            ToolTip.Tip="Sign-in, settings, caches and crash.log" />
                </WrapPanel>

                <TextBlock Text="(c) Dmitry Karpukhin 2026"
                           Classes="muted small" TextWrapping="Wrap" Margin="0,16,0,0" />

                <TextBlock Text="Not affiliated with or endorsed by Epic Games. Unreal Engine, Epic Games and Fab are trademarks of Epic Games, Inc."
                           Classes="muted small" TextWrapping="Wrap" Margin="0,16,0,0" />

            </StackPanel>

            <Border Grid.Row="1" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,20,0,0">
                <Button Content="Close" Classes="accent" HorizontalAlignment="Right" Command="{Binding CloseCommand}" IsDefault="True" IsCancel="True" />
            </Border>
        </Grid>
    </Border>
</UserControl>
