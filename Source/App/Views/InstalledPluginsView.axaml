<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UnVault.App.ViewModels"
             x:Class="UnVault.App.Views.InstalledPluginsView"
             x:DataType="vm:InstalledPluginsViewModel"
             Width="640">

    <Border Classes="card dialog">
        <Grid RowDefinitions="Auto,*,Auto" MaxHeight="620">

            <StackPanel Margin="24,20,24,8" Spacing="2">
                <TextBlock Text="Installed Plugins" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Classes="muted small" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- One row per plugin: its icon, name, own version and size; then what can be done with it -->
            <Grid Grid.Row="1" Margin="24,0" RowDefinitions="Auto,Auto,*">
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Margin="0,12" />
                <TextBlock Grid.Row="1" Text="{Binding EmptyText}" Classes="muted" TextWrapping="Wrap" Margin="0,8"
                           IsVisible="{Binding EmptyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <!-- Reaches into the dialog's right padding, so the scroll bar has a lane of its own beside the buttons -->
                <ScrollViewer Grid.Row="2" MaxHeight="440" Margin="0,0,-18,0">
                    <ItemsControl ItemsSource="{Binding Plugins}" Margin="0,0,18,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:InstalledPluginViewModel">
                                <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <!-- The plugin's own icon; a plug where it has none -->
                                        <Border Width="32" Height="32" CornerRadius="6" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Center"
                                                Background="{StaticResource PictureBackgroundBrush}">
                                            <Panel>
                                                <Path Data="M5.5,1.5 V4.5 M10.5,1.5 V4.5 M3.5,4.5 H12.5 V8 A4.5,4.5 0 0 1 3.5,8 Z M8,12.5 V14.5"
                                                      Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}" />
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" />
                                            </Panel>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                                            <TextBlock Text="{Binding Details}" Classes="muted small" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="Show in Folder" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding ShowInFolderCommand}" IsVisible="{Binding HasFolder}" />
                                        <Button Grid.Column="3" Content="Remove" Margin="8,0,0,0" VerticalAlignment="Center" Command="{Binding RemoveCommand}"
                                                ToolTip.Tip="{Binding RemoveTip}" ToolTip.ShowOnDisabled="True" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,16,0,0">
                <Button Content="Close" Classes="accent" HorizontalAlignment="Right" Command="{Binding CloseCommand}" IsDefault="True" IsCancel="True" />
            </Border>
        </Grid>
    </Border>
</UserControl>
