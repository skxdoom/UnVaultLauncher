<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:UnVault.App"
             xmlns:vm="using:UnVault.App.ViewModels"
             x:Class="UnVault.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Width="620">

    <Border Classes="card dialog">
        <Grid RowDefinitions="Auto,*,Auto" MaxHeight="700">

            <TextBlock Text="{x:Static s:Strings.Settings}" FontSize="20" FontWeight="SemiBold" Margin="24,20,24,4" />

            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="24,0">
                    <TextBlock Text="{x:Static s:Strings.SectionEngineInstallFolder}" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding EngineInstallRoot}" PlaceholderText="{Binding EngineRootPlaceholder}" />
                        <Button Grid.Column="1" Content="{x:Static s:Strings.Browse}" Margin="8,0,0,0" Command="{Binding BrowseEngineRootCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding EngineRootHint}" Classes="muted small" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="{x:Static s:Strings.SectionVaultCacheFolder}" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding VaultCacheDirectory}" PlaceholderText="{Binding VaultPlaceholder}" />
                        <Button Grid.Column="1" Content="{x:Static s:Strings.Browse}" Margin="8,0,0,0" Command="{Binding BrowseVaultCacheCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding VaultSummary}" Classes="muted small" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="{x:Static s:Strings.SectionProjectFolders}" Classes="section" />
                    <Border Classes="folder" IsVisible="{Binding HasNoProjectFolders}">
                        <TextBlock Text="{Binding ProjectFoldersAutomatic}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectFoldersAutomatic}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding ProjectFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ProjectFolderItem">
                                <Border Classes="folder">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <!-- The default folder is where new projects are created -->
                                        <RadioButton IsChecked="{Binding IsDefault}" ToolTip.Tip="{Binding Path}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                        </RadioButton>
                                        <Border Grid.Column="1" Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsDefault}">
                                            <TextBlock Text="{x:Static s:Strings.Default}" />
                                        </Border>
                                        <Button Grid.Column="2" Classes="clear" Margin="4,0,-6,0" Command="{Binding RemoveCommand}" ToolTip.Tip="{x:Static s:Strings.Remove}" AutomationProperties.Name="{x:Static s:Strings.RemoveFolder}">
                                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{x:Static s:Strings.AddFolder}" Margin="0,2,0,0" Command="{Binding AddProjectFolderCommand}" />
                    <TextBlock Text="{Binding ProjectFoldersHint}" Classes="muted small" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="{x:Static s:Strings.SectionDownloads}" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Static s:Strings.ParallelDownloads}" />
                            <TextBlock Text="{x:Static s:Strings.ParallelDownloadsHint}" Classes="muted small" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1" Value="{Binding ParallelDownloads}" Minimum="1" Maximum="64" Increment="1"
                                       FormatString="0" Width="130" />
                    </Grid>

                    <TextBlock Text="{x:Static s:Strings.SectionUpdates}" Classes="section" />
                    <CheckBox Content="{x:Static s:Strings.CheckForUpdatesAtStartup}" IsChecked="{Binding CheckForUpdates}" />
                    <TextBlock Text="{x:Static s:Strings.CheckForUpdatesHint}"
                               Classes="muted small" TextWrapping="Wrap" Margin="0,4,0,0" />

                    <Border Classes="banner warning" Margin="0,16,0,0" IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{x:Static s:Strings.Cancel}" Command="{Binding CancelCommand}" IsCancel="True" />
                    <Button Content="{x:Static s:Strings.Save}" Classes="accent" Command="{Binding SaveCommand}" IsDefault="True" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
