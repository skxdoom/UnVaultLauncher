<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UnVault.App.ViewModels"
             x:Class="UnVault.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel"
             Width="620">

    <Border Classes="card" Padding="0" BoxShadow="0 12 40 0 #80000000">
        <Grid RowDefinitions="Auto,*,Auto" MaxHeight="700">

            <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="24,20,24,4" />

            <ScrollViewer Grid.Row="1">
                <StackPanel Margin="24,0">
                    <TextBlock Text="ENGINE INSTALL FOLDER" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding EngineInstallRoot}" PlaceholderText="{Binding EngineRootPlaceholder}" />
                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseEngineRootCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding EngineRootHint}" Classes="muted small" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="VAULT CACHE FOLDER" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding VaultCacheDirectory}" PlaceholderText="{Binding VaultPlaceholder}" />
                        <Button Grid.Column="1" Content="Browse…" Margin="8,0,0,0" Command="{Binding BrowseVaultCacheCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding VaultSummary}" Classes="muted small" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Button Classes="link" Margin="0,6,0,0" Command="{Binding UseEGLVaultCacheCommand}" IsVisible="{Binding HasEGLVaultCache}">
                        <TextBlock Text="{Binding EGLVaultCache, StringFormat='Use the Epic Games Launcher’s: {0}'}" TextTrimming="CharacterEllipsis" />
                    </Button>

                    <TextBlock Text="PROJECT FOLDERS" Classes="section" />
                    <Border Classes="folder" IsVisible="{Binding HasNoProjectFolders}">
                        <TextBlock Text="{Binding ProjectFoldersAutomatic}" Classes="muted" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectFoldersAutomatic}" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding ProjectFolders}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ProjectFolderItem">
                                <Border Classes="folder">
                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Classes="chip" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{Binding IsDefault}">
                                            <TextBlock Text="New projects" />
                                        </Border>
                                        <Button Grid.Column="1" Classes="link" Content="Use for New Projects" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding MakeDefaultCommand}" IsVisible="{Binding !IsDefault}" />
                                        <Button Grid.Column="2" Classes="clear" Margin="4,0,-6,0" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove">
                                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{StaticResource MutedTextBrush}" StrokeThickness="1.6" StrokeLineCap="Round" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Add Folder…" Margin="0,2,0,0" Command="{Binding AddProjectFolderCommand}" />
                    <TextBlock Text="{Binding ProjectFoldersHint}" Classes="muted small" TextWrapping="Wrap" Margin="0,6,0,0" />

                    <TextBlock Text="DOWNLOADS" Classes="section" />
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Parallel downloads" />
                            <TextBlock Text="More can be faster on fast connections; fewer is gentler on slow ones." Classes="muted small" />
                        </StackPanel>
                        <NumericUpDown Grid.Column="1" Value="{Binding ParallelDownloads}" Minimum="1" Maximum="64" Increment="1"
                                       FormatString="0" Width="130" />
                    </Grid>

                    <Border Classes="banner warning" Margin="0,16,0,0" IsVisible="{Binding HasError}">
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="24,14" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Content="Save" Classes="accent" Command="{Binding SaveCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
