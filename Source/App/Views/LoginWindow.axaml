<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="using:UnVault.App"
        x:Class="UnVault.App.Views.LoginWindow"
        Title="{x:Static s:Strings.SignInToEpicGames}"
        Width="520" Height="760" MinWidth="420" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">

    <Grid>
        <!-- Shown until the embedded browser covers the window. -->
        <StackPanel x:Name="LoadingPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
            <ProgressBar IsIndeterminate="True" Width="200" />
            <TextBlock Text="{x:Static s:Strings.OpeningSignInPage}" Classes="muted" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Fallback without WebView2: sign in in the normal browser and paste the result. -->
        <StackPanel x:Name="FallbackPanel" IsVisible="False" Margin="28" Spacing="14" VerticalAlignment="Center">
            <TextBlock Text="{x:Static s:Strings.SignInWithBrowser}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="FallbackReason" Classes="muted small" TextWrapping="Wrap" />
            <TextBlock TextWrapping="Wrap"
                       Text="{x:Static s:Strings.SignInStep1}" />
            <Button Content="{x:Static s:Strings.OpenSignInPage}" Classes="accent" Click="OnOpenBrowserClick" />
            <TextBlock TextWrapping="Wrap"
                       Text="{x:Static s:Strings.SignInStep2}" />
            <TextBox x:Name="CodeBox" PlaceholderText="{x:Static s:Strings.PasteHere}" AcceptsReturn="False" />
            <TextBlock Classes="muted small" TextWrapping="Wrap"
                       Text="{x:Static s:Strings.SignInCodeWarning}" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="{x:Static s:Strings.Cancel}" Click="OnCancelClick" />
                <Button Content="{x:Static s:Strings.SignIn}" Classes="accent" Click="OnSubmitCodeClick" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
