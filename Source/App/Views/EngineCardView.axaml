<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UnVault.App.ViewModels"
             x:Class="UnVault.App.Views.EngineCardView"
             x:DataType="vm:EngineCardViewModel">

    <Border Classes="card" Padding="0" ClipToBounds="True">
        <Panel>
            <Border Classes="edge" Classes.installed="{Binding IsInstalled}" />

            <Grid ColumnDefinitions="*,Auto" Margin="20,16,16,16">

                <StackPanel Margin="0,0,16,0" Spacing="4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Border Classes="chip" Classes.success="{Binding IsUpToDate}" Classes.warning="{Binding HasUpdate}" Classes.danger="{Binding IsStale}">
                            <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <Border Classes="chip" IsVisible="{Binding IsBusy}">
                            <TextBlock Text="Working…" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Details}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="{Binding OriginText}" Classes="muted small" IsVisible="{Binding OriginText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="Launch" Classes="accent" Command="{Binding LaunchCommand}" IsVisible="{Binding IsInstalled}" />
                    <Button Content="Install…" Classes="accent" Command="{Binding InstallCommand}" IsVisible="{Binding CanInstall}" />
                    <Button Content="Options" Command="{Binding ModifyCommand}" IsVisible="{Binding IsInstalled}" />
                    <Button Content="⋯" IsVisible="{Binding IsInstalled}" ToolTip.Tip="More" AutomationProperties.Name="More">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Installed Plugins" Command="{Binding OpenPluginsCommand}" />
                                <MenuItem Header="Verify Files" Command="{Binding VerifyCommand}" />
                                <MenuItem Header="Show in Folder" Command="{Binding OpenFolderCommand}" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Panel>
    </Border>
</UserControl>
