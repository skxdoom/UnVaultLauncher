<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="using:UnVault.App"
             xmlns:vm="using:UnVault.App.ViewModels"
             x:Class="UnVault.App.Views.OperationView"
             x:DataType="vm:OperationViewModel">

    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Phase}" Classes="muted" />
        </StackPanel>

        <StackPanel Grid.Column="1" Grid.RowSpan="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="{x:Static s:Strings.Pause}" Command="{Binding PauseCommand}" IsVisible="{Binding IsRunning}" />
            <Button Content="{Binding RetryText}" Classes="accent" Command="{Binding RetryCommand}" IsVisible="{Binding CanRetry}" />
            <!-- Not to be resumed: into the history. A square as tall as the button beside it. -->
            <Button Command="{Binding MoveToHistoryCommand}" IsVisible="{Binding CanRetry}" VerticalAlignment="Stretch"
                    Width="{Binding $self.Bounds.Height}" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    ToolTip.Tip="{x:Static s:Strings.MoveToHistory}" AutomationProperties.Name="{x:Static s:Strings.MoveToHistory}">
                <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.6" StrokeLineCap="Round" />
            </Button>
        </StackPanel>

        <ProgressBar Grid.Row="1" Margin="0,6" Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" IsVisible="{Binding IsRunning}" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="16">
            <TextBlock Text="{Binding ProgressText}" Classes="muted small" IsVisible="{Binding IsRunning}" />
            <TextBlock Text="{Binding SpeedText}" Classes="muted small" IsVisible="{Binding IsRunning}" />
            <TextBlock Text="{Binding Message}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding IsSucceededOrCancelled}" />
            <TextBlock Text="{Binding Message}" Classes="small" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" IsVisible="{Binding IsFailed}" />
        </StackPanel>
    </Grid>
</UserControl>
