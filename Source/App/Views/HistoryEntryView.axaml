<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:UnVault.App.ViewModels"
             x:Class="UnVault.App.Views.HistoryEntryView"
             x:DataType="vm:HistoryEntryViewModel">

    <!-- A finished operation: what, how it ended and when, and a next step it offered (this session only) -->
    <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="3" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                <TextBlock Text="{Binding OutcomeText}" Classes="small" VerticalAlignment="Center" Foreground="{StaticResource SuccessBrush}" IsVisible="{Binding IsCompleted}" />
                <TextBlock Text="{Binding OutcomeText}" Classes="muted small" VerticalAlignment="Center" IsVisible="{Binding IsPaused}" />
                <TextBlock Text="{Binding OutcomeText}" Classes="small" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}" IsVisible="{Binding IsFailed}" />
            </StackPanel>
            <TextBlock Text="{Binding Message}" Classes="muted small" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center" Margin="16,0,0,0">
            <Button Content="{Binding FollowUpText}" Classes="accent" Command="{Binding RunFollowUpCommand}" IsVisible="{Binding HasFollowUp}" />
            <TextBlock Text="{Binding WhenText}" Classes="muted small" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
