<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UnVault.App.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Neutral greys with the logo's blue as the accent; yellow is kept for updates, which should catch the eye -->
        <SolidColorBrush x:Key="WindowBackgroundBrush">#141414</SolidColorBrush>
        <SolidColorBrush x:Key="HeaderBackgroundBrush">#191919</SolidColorBrush>
        <SolidColorBrush x:Key="CardBackgroundBrush">#1C1C1C</SolidColorBrush>
        <SolidColorBrush x:Key="CardHoverBrush">#222222</SolidColorBrush>
        <SolidColorBrush x:Key="CardBorderBrush">#2B2B2B</SolidColorBrush>
        <SolidColorBrush x:Key="PictureBackgroundBrush">#242424</SolidColorBrush>
        <SolidColorBrush x:Key="MutedTextBrush">#9C9C9C</SolidColorBrush>
        <SolidColorBrush x:Key="AccentBrushUL">#3E70D8</SolidColorBrush>
        <!-- Links: the logo's lighter blue, readable as text on the dark background -->
        <SolidColorBrush x:Key="AccentTextBrush">#6B9BF2</SolidColorBrush>
        <SolidColorBrush x:Key="OnAccentBrush">#FFFFFF</SolidColorBrush>
        <SolidColorBrush x:Key="SuccessBrush">#3CC47C</SolidColorBrush>
        <SolidColorBrush x:Key="WarningBrush">#E2A616</SolidColorBrush>
        <SolidColorBrush x:Key="DangerBrush">#EF5B5B</SolidColorBrush>
        <SolidColorBrush x:Key="OverlayBrush">#B0000000</SolidColorBrush>

        <!-- Text and check marks on the accent -->
        <StaticResource x:Key="AccentButtonForeground" ResourceKey="OnAccentBrush" />
        <StaticResource x:Key="AccentButtonForegroundPointerOver" ResourceKey="OnAccentBrush" />
        <StaticResource x:Key="AccentButtonForegroundPressed" ResourceKey="OnAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundChecked" ResourceKey="OnAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" ResourceKey="OnAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" ResourceKey="OnAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminate" ResourceKey="OnAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePointerOver" ResourceKey="OnAccentBrush" />
        <StaticResource x:Key="CheckBoxCheckGlyphForegroundIndeterminatePressed" ResourceKey="OnAccentBrush" />

        <!-- Width of the page content (Engines and Library alike), centered in wider windows -->
        <x:Double x:Key="PageMaxWidth">1400</x:Double>

        <!-- Fluent rests the scroll thumb at 2 px (16 px scaled by 0.125) and only widens it under the pointer. -->
        <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.375) translateX(-2px)</TransformOperations>
        <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.375) translateY(-2px)</TransformOperations>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Dark" Accent="#FF3E70D8" RegionColor="#FF141414" />
            </FluentTheme.Palettes>
        </FluentTheme>

        <!-- Text -->
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="TextBlock.small">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <!-- Cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
        </Style>

        <!-- The bar along an engine card's left edge: blue when installed, grey when the files are gone -->
        <Style Selector="Border.edge">
            <Setter Property="Width" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="#3A3A3A" />
        </Style>
        <Style Selector="Border.edge.installed">
            <Setter Property="Background" Value="{StaticResource AccentBrushUL}" />
        </Style>

        <!-- Status chips -->
        <Style Selector="Border.chip">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.chip > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="Border.chip.success">
            <Setter Property="Background" Value="#17301F" />
        </Style>
        <Style Selector="Border.chip.success > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
        </Style>
        <Style Selector="Border.chip.warning">
            <Setter Property="Background" Value="#3A2E10" />
        </Style>
        <Style Selector="Border.chip.warning > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        </Style>
        <Style Selector="Border.chip.danger">
            <Setter Property="Background" Value="#3A1A1A" />
        </Style>
        <Style Selector="Border.chip.danger > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>

        <!-- Selected rows in lists (e.g. the engine to install into): a blue tint instead of Fluent's solid accent -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1E2D4A" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#253757" />
        </Style>
        <Style Selector="ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A263E" />
        </Style>

        <!-- Banners -->
        <Style Selector="Border.banner">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Background" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#333333" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <!-- A folder in a list (Settings > Project Folders), drawn like a read-only text box -->
        <Style Selector="Border.folder">
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Border.folder > TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.banner.warning">
            <Setter Property="Background" Value="#2D2610" />
            <Setter Property="BorderBrush" Value="#5C4C16" />
        </Style>

        <!-- Buttons -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
        <Style Selector="Button.subtle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!-- Disabled (e.g. Refresh while refreshing): only the content greys out, no box appears -->
        <Style Selector="Button.subtle:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <!-- Header tabs: the active one stays highlighted, also on hover -->
        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
        </Style>
        <Style Selector="Button.tab.active /template/ ContentPresenter#PART_ContentPresenter, Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2A2A2A" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <!-- Yellow Update: replaces a Library tile's main button while Fab has a newer build -->
        <Style Selector="Button.update">
            <Setter Property="Background" Value="{StaticResource WarningBrush}" />
            <Setter Property="Foreground" Value="#1A1405" />
        </Style>
        <Style Selector="Button.update:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EDB83E" />
            <Setter Property="Foreground" Value="#1A1405" />
        </Style>
        <Style Selector="Button.update:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C9930F" />
            <Setter Property="Foreground" Value="#1A1405" />
        </Style>
        <Style Selector="Button.clear">
            <Setter Property="Padding" Value="7" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.clear /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.clear:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource CardBorderBrush}" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
        </Style>
    </Application.Styles>
</Application>
